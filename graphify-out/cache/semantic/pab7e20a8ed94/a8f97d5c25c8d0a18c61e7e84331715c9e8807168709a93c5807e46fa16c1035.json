{"nodes": [{"id": "documents_amotif_ideias_e_planejamento_amotif", "label": "AMOTIF Platform", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1 \u2014 Se\u00e7\u00e3o: Conceito do AMOTIF", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A digital asynchronous musical collaboration platform for collective creation of musical works through structured contributions of independent instrumental layers. Unlike traditional social networks built around publishing finished content, AMOTIF acts DURING the creative process, so musicians can take part in building a song without direct contact with each other."}, {"id": "documents_amotif_ideias_e_planejamento_colaboracao_assincrona", "label": "Colabora\u00e7\u00e3o Musical Ass\u00edncrona", "file_type": "rationale", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main objective of the platform is to remove geographic and logistical barriers of collaborative music production, letting artists from different places contribute to the same work in an organized, technical and safe manner."}, {"id": "documents_amotif_ideias_e_planejamento_projetos_compartilhados", "label": "Projetos Musicais Compartilhados", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_amotif_ideias_e_planejamento_camadas_instrumentais", "label": "Camadas Instrumentais Independentes", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each contribution is registered as an independent layer that never overwrites previous contributions, preserving the creative history. Inspired by distributed versioning concepts, a song evolves progressively through multiple participations, forming a transparent creative timeline with explicit credit for each musician."}, {"id": "documents_amotif_ideias_e_planejamento_aprovacao_do_criador", "label": "Aprova\u00e7\u00e3o Controlada pelo Criador do Projeto", "file_type": "rationale", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The project creator decides which contributions officially become part of the composition, balancing open collaboration with centralized artistic direction."}, {"id": "documents_amotif_ideias_e_planejamento_linha_do_tempo_criativa", "label": "Linha do Tempo Criativa Transparente", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_amotif_ideias_e_planejamento_credito_autoral", "label": "Cr\u00e9dito Expl\u00edcito de Autoria", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each musician receives explicit credit for their participation, establishing an environment that values authorship and cooperation."}, {"id": "documents_amotif_ideias_e_planejamento_usuario", "label": "Usu\u00e1rio (Entidade de Identidade)", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1-2 \u2014 2.A Usu\u00e1rio (A Identidade)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_amotif_ideias_e_planejamento_projeto", "label": "Projeto (Entidade M\u00fasica)", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 2 \u2014 2.B Projeto (A M\u00fasica)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_amotif_ideias_e_planejamento_camada", "label": "Camada / Layer (Entidade de Contribui\u00e7\u00e3o)", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 2 \u2014 2.C Camadas/Layers", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_amotif_ideias_e_planejamento_bpm", "label": "BPM (Batidas por Minuto)", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 2 \u2014 2.B Projeto", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 'clock' of the song: without it the collaborator does not know at what speed to record and the music becomes a mess."}, {"id": "documents_amotif_ideias_e_planejamento_escala_tom", "label": "Escala / Tom", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 2 \u2014 2.B Projeto", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tells the musician which notes they may play (e.g. 'D\u00f3 Maior')."}, {"id": "documents_amotif_ideias_e_planejamento_audio_guia", "label": "\u00c1udio Guia (Faixa Guia)", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 2 \u2014 2.B Projeto", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First track (possibly just guitar and voice) that serves as the base for all other contributions aligned to the project."}, {"id": "documents_amotif_ideias_e_planejamento_delay_offset", "label": "Delay / Offset de Alinhamento", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 2 \u2014 2.C Camadas/Layers", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Millisecond adjustment to guarantee the track is perfectly aligned with the base track."}, {"id": "documents_amotif_ideias_e_planejamento_cpf", "label": "CPF (Valida\u00e7\u00e3o de Usu\u00e1rio Real)", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1 \u2014 2.A Usu\u00e1rio", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Security and validation that the user is real; useful if copyright protection is implemented in the future."}, {"id": "documents_amotif_ideias_e_planejamento_hash_senha", "label": "Hash de Senha", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1 \u2014 2.A Usu\u00e1rio", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_amotif_ideias_e_planejamento_backend_nodejs", "label": "Backend Principal (Node.js)", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 3 \u2014 6. Arquitetura de Fluxo de Arquivos", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_amotif_ideias_e_planejamento_fastify", "label": "Fastify", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 2 \u2014 3. Entendendo a Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 'race car' of Node.js: much faster than Express, ideal for audio flows and heavy validations."}, {"id": "documents_amotif_ideias_e_planejamento_prisma_orm", "label": "Prisma ORM", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 2 \u2014 3. Entendendo a Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write TypeScript and it translates to the database; if the project moves from Neon to Supabase tomorrow the code stays nearly the same."}, {"id": "documents_amotif_ideias_e_planejamento_zod", "label": "Zod", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 2 \u2014 3. Entendendo a Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guarantees the user cannot send text where a CPF should be, or a 1GB file where the limit is 10MB."}, {"id": "documents_amotif_ideias_e_planejamento_supabase_storage", "label": "Supabase Storage", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 2 \u2014 3. Entendendo a Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audio is heavy: the database (Neon) stores the link while Supabase stores the physical file, which is the best way to keep cost at zero."}, {"id": "documents_amotif_ideias_e_planejamento_go_fiber", "label": "Go (Fiber)", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 3 \u2014 3. Entendendo a Stack / 5. Microsservi\u00e7o", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acts as the 'heavy-load doorman': receives audio binaries with minimal latency and low memory consumption, running as a lightweight native binary without heavy VM overhead."}, {"id": "documents_amotif_ideias_e_planejamento_microsservico_audio", "label": "Microsservi\u00e7o de Processamento de \u00c1udio", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 3 \u2014 5. O Microsservi\u00e7o de Processamento de \u00c1udio", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dedicated exclusively to heavy file traffic so AMOTIF can support multiple simultaneous uploads without compromising the main business logic."}, {"id": "documents_amotif_ideias_e_planejamento_goroutines", "label": "Goroutines", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 3 \u2014 Por que Go (Golang)?", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low-cost concurrency: process several uploads at once with insignificant CPU and RAM usage."}, {"id": "documents_amotif_ideias_e_planejamento_pipe_http", "label": "Pipe HTTP de Streaming para Supabase", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 3 \u2014 6. Arquitetura de Fluxo de Arquivos", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instead of loading the whole file into RAM, Go channels the audio from the user directly to Supabase Storage as the data arrives."}, {"id": "documents_amotif_ideias_e_planejamento_neon", "label": "Neon (Banco de Dados)", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 2-4 \u2014 Stack e Arquitetura de Fluxo", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_amotif_ideias_e_planejamento_jwt", "label": "Autentica\u00e7\u00e3o JWT", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 3 \u2014 6. Arquitetura de Fluxo de Arquivos", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_amotif_ideias_e_planejamento_fluxo_de_arquivos", "label": "Arquitetura de Fluxo de Arquivos", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 3-4 \u2014 6. Arquitetura de Fluxo de Arquivos", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audio traffic follows an optimized path to avoid bottlenecks: business validation in Node.js, handover of the binary to the Go upload_service on port 4444, schema validation plus HTTP pipe to Supabase Storage, and finally persistence of the returned URL."}, {"id": "documents_amotif_ideias_e_planejamento_fluxo_de_colaboracao", "label": "Fluxo de Colabora\u00e7\u00e3o (Exemplo Pr\u00e1tico)", "file_type": "concept", "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 3 \u2014 4. Fluxo de Colabora\u00e7\u00e3o", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jo\u00e3o creates 'Samba de Ver\u00e3o' at BPM 110 with a guitar track; Maria downloads it, records a flute and uploads her layer; Jo\u00e3o is notified, plays both synchronized and clicks Approve, making two official instruments."}], "edges": [{"source": "documents_amotif_ideias_e_planejamento_amotif", "target": "documents_amotif_ideias_e_planejamento_colaboracao_assincrona", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1", "weight": 1.0}, {"source": "documents_amotif_ideias_e_planejamento_amotif", "target": "documents_amotif_ideias_e_planejamento_projetos_compartilhados", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1", "weight": 1.0}, {"source": "documents_amotif_ideias_e_planejamento_amotif", "target": "documents_amotif_ideias_e_planejamento_camadas_instrumentais", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documents/Amotif ideias e planejamento.pdf", "source_location": "Page 1", "weight": 1.0}, {"source": "documents_amotif_ideias_e_planejamento_amotif", "target": "documents_amotif_ideias_e_planejamento_aprovacao