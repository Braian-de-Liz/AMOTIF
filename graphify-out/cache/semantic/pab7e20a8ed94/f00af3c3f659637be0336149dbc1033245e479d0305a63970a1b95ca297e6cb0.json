{"nodes": [{"id": "readme_amotif", "label": "AMOTIF", "file_type": "document", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plataforma de colaboracao musical assincrona que preenche a lacuna entre DAWs locais e plataformas genericas de compartilhamento de arquivos."}, {"id": "readme_git_para_musicos", "label": "Git para Musicos", "file_type": "rationale", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inspirado em versionamento distribuido: cada contribuicao e uma camada independente que nao sobrescreve as anteriores, preservando o historico criativo."}, {"id": "readme_fluxo_colaboracao", "label": "Fluxo de Colaboracao Musical", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fluxo_aprovacao", "label": "Fluxo de Aprovacao de Contribuicoes", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equilibra colaboracao aberta com direcao artistica centralizada: o criador do projeto decide quais contribuicoes passam a integrar oficialmente a composicao."}, {"id": "readme_sincronizacao_offset", "label": "Offset de Sincronizacao Temporal", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offset em milissegundos garante alinhamento perfeito entre camadas gravadas em momentos e locais diferentes."}, {"id": "readme_fastify_plugins", "label": "Arquitetura Flat Baseada em Plugins Fastify", "file_type": "rationale", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cada dominio e um plugin Fastify autonomo com rotas e schemas; a requisicao vai de Rota direto ao Prisma, sem Controllers/Services/Repositories, reduzindo boilerplate."}, {"id": "readme_type_safety", "label": "Type-Safety End-to-End", "file_type": "rationale", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bun + Fastify + TypeBox dao tipos compartilhados, validacao em boundaries e schema unico para validacao e serializacao; validar 5 campos cai de ~30 linhas manuais para ~5."}, {"id": "readme_upload_flow", "label": "Fluxo de Upload de Audio", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upload multipart, validacao de tamanho (40MB), streaming para o Supabase Storage e persistencia da URL na Layer via Prisma evita carregar o arquivo inteiro em memoria."}, {"id": "readme_cleanup_endpoint", "label": "POST /api/cleanup", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rota de manutencao para cron, autenticada por header x-cleanup-secret e nao por JWT; sem CLEANUP_SECRET responde 503."}, {"id": "readme_sessao_refresh", "label": "Sessao JWT com Refresh Token Rotativo", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Access token de 4h e refresh de 7 dias rotacionado a cada uso; reapresentar token rotacionado encerra todas as sessoes do usuario (protecao contra replay)."}, {"id": "readme_cpf_seguranca", "label": "Validacao e Criptografia de CPF", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CPF criptografado com AES-256-GCM e indexado por HMAC (cpf_hash) para busca; perda da CPF_ENCRYPTION_KEY torna os CPFs ilegiveis. Justificativa: seguranca e futura protecao de direitos autorais."}, {"id": "readme_modelo_dados", "label": "Modelo de Dados do AMOTIF", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_stack_tecnologico", "label": "Stack Tecnologica", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_estudio_virtual", "label": "Estudio Virtual (Mixer e Waveforms)", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fastify", "label": "Fastify v5", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Framework mais rapido do ecossistema Node.js (~45k req/s vs ~15k do Express) com validacao nativa de schemas e performance minima."}, {"id": "readme_bun", "label": "Bun Runtime", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Startup em ~50ms (vs ~200ms do Node.js), ~50k req/s e ~30MB de memoria base, mantendo compatibilidade com o ecossistema Node.js."}, {"id": "readme_prisma", "label": "Prisma v7", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acesso type-safe em TypeScript com migrations versionadas; trocar o provider de banco exige pouca mudanca de codigo."}, {"id": "readme_typebox", "label": "TypeBox", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schemas executaveis que geram tipos automaticamente e garantem type-safety em runtime (ex.: impedir texto onde se espera CPF)."}, {"id": "readme_supabase_storage", "label": "Supabase Storage", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O banco (Neon) guarda o link e o Supabase guarda o arquivo fisico, mantendo o custo baixo e a entrega global."}, {"id": "readme_postgresql_neon", "label": "PostgreSQL (Neon)", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_react", "label": "React 19 + Vite + TypeScript", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_render", "label": "Render (Deploy)", "file_type": "concept", "source_file": "README.mD", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_amotif", "target": "readme_git_para_musicos", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.mD", "source_location": null, "weight": 1.0}, {"source": "readme_amotif", "target": "readme_fluxo_colaboracao", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.mD", "source_location": null, "weight": 1.0}, {"source": "readme_amotif", "target": "readme_fluxo_aprovacao", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.mD", "source_location": null, "weight": 1.0}, {"source": "readme_amotif", "target": "readme_sincronizacao_offset", "relation": "re