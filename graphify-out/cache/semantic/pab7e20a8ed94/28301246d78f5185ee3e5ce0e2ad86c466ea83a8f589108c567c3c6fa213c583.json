{"nodes": [{"id": "documents_organization_doc", "label": "Fastify Structure - AMOTIF", "file_type": "document", "source_file": "documents/organization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_organization_fastify_native", "label": "Filosofia Fastify-Native (sem MVC)", "file_type": "rationale", "source_file": "documents/organization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decisao deliberada por performance maxima, baixo acoplamento e manutenibilidade: Fastify foi desenhado como grafo de plugins, entao Controllers/Services/Repositories apenas adicionariam indirecao."}, {"id": "documents_organization_schema_first", "label": "Schema-First Design (TypeBox + Fastify)", "file_type": "rationale", "source_file": "documents/organization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schemas TypeBox sao a unica fonte da verdade: validam body/params/query/headers, geram tipos TypeScript e sao compilados JIT pelo Fastify, eliminando validacao manual."}, {"id": "documents_organization_hooks_encapsulation", "label": "Encapsulamento de Autorizacao via Hooks", "file_type": "concept", "source_file": "documents/organization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_organization_flat_route_prisma", "label": "Estrutura Flat: Rota -> Prisma", "file_type": "rationale", "source_file": "documents/organization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remove as camadas Controller -> Service -> Repository -> Prisma; services que so repassam dados viram pass-through desnecessario."}, {"id": "documents_organization_service_extraction", "label": "Criterios para Extrair Services", "file_type": "rationale", "source_file": "documents/organization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A abordagem flat nao e dogma: extrai-se service quando a logica e compartilhada por 2+ rotas, envolve multiplas queries Prisma em uma unidade de negocio ou compromete a legibilidade da rota."}, {"id": "documents_organization_boilerplate_reduction", "label": "Reducao de Boilerplate e Indirecao", "file_type": "rationale", "source_file": "documents/organization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Menos arquivos e menos codigo significam desenvolvimento mais rapido, menor superficie de bugs e alteracoes localizadas em rota + schema."}, {"id": "documents_organization_bun_performance", "label": "Performance com Bun (JIT e Funcoes Puras)", "file_type": "rationale", "source_file": "documents/organization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Estrutura baseada em funcoes (rotas e hooks) e mais amigavel ao JIT do Bun; instancias de classes injetadas criam overhead desnecessario."}, {"id": "documents_organization_error_handling", "label": "Tratamento Centralizado de Erros", "file_type": "concept", "source_file": "documents/organization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_organization_schema_mirroring", "label": "Espelhamento de Pastas Routers/Schemas", "file_type": "rationale", "source_file": "documents/organization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cada rota tem seu schema no mesmo caminho relativo; reduz impacto de mudancas e acelera onboarding."}, {"id": "documents_organization_thirteen_domains", "label": "Organizacao dos 13 Dominios de Rota", "file_type": "conce