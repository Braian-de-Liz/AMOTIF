{"nodes": [{"id": "frontend_public_assets_logo_brand_mark", "label": "AMOTIF Brand Mark (Treble Clef with Radial Instrument Arms)", "file_type": "image", "source_file": "frontend/public/assets/logo.svg", "source_location": "viewBox 0 0 600 600", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stylized green treble clef forms the spine and central rings of the mark, with five curved arms radiating out to a microphone, a trumpet, an acoustic guitar, a bass drum and a keyboard. The composition symbolizes one shared musical core fed by many different instruments/contributors \u2014 the visual statement of layered collaborative composition."}, {"id": "frontend_public_assets_logo_clave_de_sol", "label": "Clave de Sol (Treble Clef Core)", "file_type": "image", "source_file": "frontend/public/assets/logo.svg", "source_location": "Lines 18-56 \u2014 CLAVE DE SOL REAL", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organic clef body, upper loop, vertical stem, concentric center rings and lower tail form the hub from which every instrument arm grows."}, {"id": "frontend_public_assets_logo_braco_microfone", "label": "Bra\u00e7o Curvo \u2014 Microfone", "file_type": "image", "source_file": "frontend/public/assets/logo.svg", "source_location": "Lines 58-72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upper-left arm; microphone with diagonal grille lines, representing vocals and recording."}, {"id": "frontend_public_assets_logo_braco_trompete", "label": "Bra\u00e7o Curvo \u2014 Trompete", "file_type": "image", "source_file": "frontend/public/assets/logo.svg", "source_location": "Lines 74-106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upper-right arm; trumpet body, bell, valves and a small white note, representing brass/horns."}, {"id": "frontend_public_assets_logo_braco_violao", "label": "Bra\u00e7o Curvo \u2014 Viol\u00e3o", "file_type": "image", "source_file": "frontend/public/assets/logo.svg", "source_location": "Lines 109-124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Right arm; circular guitar body with three strings and sound hole, representing string instruments."}, {"id": "frontend_public_assets_logo_braco_bumbo", "label": "Bra\u00e7o Curvo \u2014 Bumbo", "file_type": "image", "source_file": "frontend/public/assets/logo.svg", "source_location": "Lines 126-144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bottom arm; tilted cylindrical bass drum with three small notes, representing percussion and rhythm."}, {"id": "frontend_public_assets_logo_braco_teclado", "label": "Bra\u00e7o Curvo \u2014 Teclado", "file_type": "image", "source_file": "frontend/public/assets/logo.svg", "source_location": "Lines 146-180", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Left arm; rounded keyboard body with five white and four black keys plus notes, representing keys/synths."}, {"id": "frontend_public_assets_logo_paleta_verde", "label": "Paleta Verde (gradPrincipal / gradClaro)", "file_type": "image", "source_file": "frontend/public/assets/logo.svg", "source_location": "Lines 3-14 \u2014 defs/linearGradient", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vertical gradient from dark forest green #2c3e2c through #6b8e4d to #8fb08f over a near-white mint background #f4f9f4: organic, calm, growth-oriented tone rather than a generic tech palette."}], "edges": [{"source": "frontend_public_assets_logo_brand_mark", "target": "frontend_public_assets_logo_clave_de_sol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/public/assets/logo.svg", "source_location": "Lines 18-56", "weight": 1.0}, {"source": "frontend_public_assets_logo_bra